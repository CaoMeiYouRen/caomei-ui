{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "moduleResolution": "Bundler",
        "allowJs": true,
        "checkJs": false
    },
    "include": [
        "./.vitepress/**/*.ts",
        "./.vitepress/**/*.vue",
        "./examples/**/*.ts",
        "./examples/**/*.vue",
        "./i18n/**/*.ts",
        "./i18n/**/*.vue"
    ],
    "exclude": [
        "./.vitepress/cache",
        "./.vitepress/dist"
    ]
}
