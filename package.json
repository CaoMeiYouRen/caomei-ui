{
  "name": "caomei-ui",
  "version": "0.6.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/styles/index.css",
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "import": "./dist/resolver.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "lint": "cross-env NODE_ENV=production eslint . --fix",
    "lint:check": "cross-env NODE_ENV=production eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.{html,css,scss,sass,vue}\" \"docs/.vitepress/theme/**/*.{css,scss,html,vue}\" --fix",
    "lint:css:check": "stylelint \"src/**/*.{html,css,scss,sass,vue}\" \"docs/.vitepress/theme/**/*.{css,scss,html,vue}\"",
    "lint:md": "lint-md \"*.md\" \"docs/**/*.md\" \".github/**/*.md\" --fix",
    "lint:md:check": "lint-md \"*.md\" \"docs/**/*.md\" \".github/**/*.md\"",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:docs": "pnpm docs:gen && vue-tsc -p docs/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:gallery": "playwright test --config playwright.gallery.config.ts",
    "test:a11y": "vitest run test/a11y",
    "docs:gen": "node scripts/docs/gen-component-meta.mjs",
    "docs:dev": "pnpm docs:gen && vitepress dev docs --open",
    "docs:build": "pnpm docs:gen && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check:integrity": "node scripts/docs/check-docs-integrity.mjs",
    "docs:check:links": "node scripts/docs/check-links.mjs",
    "docs:check:line-count": "node scripts/docs/check-line-count.mjs",
    "docs:check:i18n-routing": "node scripts/docs/check-i18n-routing.mjs",
    "docs:check:i18n": "node scripts/docs/check-i18n-old-dirs.mjs",
    "docs:check:structure": "node scripts/docs/check-docs-structure.mjs",
    "docs:check:config-links": "node scripts/docs/check-config-links.mjs",
    "docs:check:i18n-parity": "node scripts/docs/check-i18n-parity.mjs",
    "docs:check:version": "node scripts/docs/check-site-version.mjs",
    "docs:check:interpolation": "node scripts/docs/check-interpolation.mjs",
    "docs:check:example-refs": "node scripts/docs/check-example-refs.mjs",
    "docs:check:showcase": "node scripts/docs/check-showcase-registry.mjs",
    "docs:check": "pnpm docs:check:integrity && pnpm docs:check:links && pnpm docs:check:structure && pnpm docs:check:config-links && pnpm docs:check:i18n-parity && pnpm docs:check:version && pnpm docs:check:interpolation && pnpm docs:check:example-refs && pnpm docs:check:showcase && pnpm docs:check:line-count && pnpm docs:check:i18n",
    "check:standards-redundant": "node scripts/governance/check-standards-redundant.mjs",
    "check:standards-redundant:strict": "node scripts/governance/check-standards-redundant.mjs --strict",
    "check:design": "node scripts/governance/check-design.mjs",
    "check:overlay-z-index": "node scripts/governance/check-overlay-z-index.mjs",
    "check:class-prefix": "node scripts/governance/check-class-prefix.mjs",
    "check:reka-trigger-usage": "node scripts/governance/check-reka-trigger-usage.mjs",
    "check:docs-git-revision": "node scripts/governance/check-docs-git-revision.mjs",
    "check:licenses": "node scripts/governance/check-licenses.mjs",
    "check:locale-keys": "node scripts/governance/check-locale-keys.mjs",
    "check:locale-ledger": "node scripts/governance/check-locale-ledger.mjs",
    "check:components-overview": "node scripts/governance/check-components-overview.mjs",
    "check:design-catalog": "node scripts/governance/check-design-catalog.mjs",
    "check:migration-consistency": "node scripts/governance/check-migration-consistency.mjs",
    "check:build": "node scripts/release/check-build.mjs",
    "check:nuxt": "node scripts/release/check-nuxt.mjs",
    "check:coverage": "node scripts/governance/check-coverage.mjs",
    "capture:styles": "node test/capture/capture.mjs",
    "capture:styles:freeze": "node test/capture/capture.mjs --freeze",
    "test:nuxt-smoke": "pnpm build && pnpm check:nuxt",
    "distill:wisdom": "node scripts/governance/distill-wisdom.mjs",
    "check:distill-archive": "node scripts/governance/distill-wisdom.mjs --reconcile",
    "ai:check": "node scripts/ai/check-governance.mjs",
    "check:audit-protocol": "node scripts/governance/check-audit-protocol.mjs",
    "check:ai-asset-links": "node scripts/governance/check-ai-asset-links.mjs",
    "check:planning-numbers": "node scripts/governance/check-planning-numbers.mjs",
    "check:final-newline": "node scripts/governance/check-final-newline.mjs",
    "check:governance-records": "node scripts/governance/check-governance-records.mjs",
    "check:review-gate": "node scripts/governance/check-review-gate-artifacts.mjs",
    "review-gate:index": "node scripts/governance/gen-review-gate-index.mjs",
    "governance:check": "pnpm check:standards-redundant:strict && pnpm check:design && pnpm check:overlay-z-index && pnpm check:class-prefix && pnpm check:reka-trigger-usage && pnpm check:docs-git-revision && pnpm check:licenses && pnpm check:locale-keys && pnpm check:locale-ledger && pnpm check:components-overview && pnpm check:design-catalog && pnpm check:migration-consistency && pnpm ai:check && pnpm check:audit-protocol && pnpm check:ai-asset-links && pnpm check:planning-numbers && pnpm check:governance-records && pnpm check:final-newline && pnpm check:distill-archive && pnpm docs:check && node scripts/governance/guard-ref-attrs.mjs",
    "verify": "pnpm lint:check && pnpm lint:css:check && pnpm lint:md:check && pnpm typecheck && pnpm typecheck:docs && pnpm test && pnpm build && pnpm check:build && pnpm check:resolver && pnpm check:nuxt && pnpm docs:build && pnpm docs:check:i18n-routing && pnpm governance:check",
    "setup:ai": "node scripts/setup/setup-ai.mjs",
    "commit": "cz",
    "prepare": "husky",
    "prepublishOnly": "node scripts/governance/check-licenses.mjs",
    "changelog": "node scripts/release/generate-changelog.mjs",
    "release": "semantic-release",
    "release:manual": "node scripts/release/manual-release.mjs",
    "check:resolver": "node scripts/release/check-resolver.run.mjs"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@lucide/vue": "^1.45.0",
    "@tanstack/vue-table": "9.2.4",
    "@vavt/cm-extension": "^2.0.0",
    "reka-ui": "2.10.4"
  },
  "devDependencies": {
    "@lint-md/cli": "^2.3.1",
    "@nuxt/kit": "^4.5.2",
    "@nuxt/schema": "^4.5.2",
    "@playwright/test": "^1.63.0",
    "@tsdown/css": "^0.23.0",
    "@types/node": "^26.5.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "axe-core": "^4.13.0",
    "commitizen": "^4.3.2",
    "commitlint": "^21.2.2",
    "commitlint-config-cmyr": "^1.0.1",
    "conventional-changelog": "7.2.0",
    "conventional-changelog-cmyr-config": "3.0.0",
    "cross-env": "^10.0.0",
    "cz-conventional-changelog-cmyr": "^2.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.34.0",
    "eslint-config-cmyr": "^2.3.1",
    "eslint-plugin-vue": "^10.11.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "md-editor-v3": "^7.1.0",
    "nuxt": "^4.5.2",
    "postcss": "^8.5.28",
    "sass": "^1.104.0",
    "semantic-release": "^25.0.9",
    "semantic-release-cmyr-config": "^1.0.2",
    "stylelint": "^17.15.0",
    "stylelint-config-cmyr": "^1.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "unplugin-vue": "^8.0.0",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4",
    "vitepress-demo-plugin": "^1.8.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",
    "vue-component-meta": "^3.3.11",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "@nuxt/kit": "^4.0.0",
    "md-editor-v3": "^7.1.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "md-editor-v3": {
      "optional": true
    }
  },
  "author": "CaoMeiYouRen",
  "description": "一个基于 Vue 3 和 Reka UI 的自建组件库，强调组件与样式解耦，默认提供极简可用的样式并支持 100% 自定义覆盖。开箱即用主题切换与暗色模式，组件设计适配桌面端与移动端。",
  "keywords": [
    "vue3",
    "component-library",
    "reka-ui",
    "theme-switch",
    "responsive",
    "vue",
    "vite"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "THIRD-PARTY-LICENSES"
  ],
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/CaoMeiYouRen/caomei-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaoMeiYouRen/caomei-ui.git"
  },
  "bugs": {
    "url": "https://github.com/CaoMeiYouRen/caomei-ui/issues"
  },
  "config": {},
  "changelog": {
    "language": "zh"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "npm run lint",
      "git add"
    ]
  }
}
