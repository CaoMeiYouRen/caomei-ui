{
  "name": "caomei-ui",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "import": "./dist/resolver.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "lint": "cross-env NODE_ENV=production eslint . --fix",
    "lint:check": "cross-env NODE_ENV=production eslint . --max-warnings 10",
    "lint:css": "stylelint src/**/*.{html,css,scss,sass,vue} --fix",
    "lint:css:check": "stylelint src/**/*.{html,css,scss,sass,vue}",
    "lint:md": "lint-md \"*.md\" \"docs/**/*.md\" --fix",
    "lint:md:check": "lint-md \"*.md\" \"docs/**/*.md\"",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check:links": "node scripts/docs/check-links.mjs",
    "docs:check:line-count": "node scripts/docs/check-line-count.mjs",
    "docs:check": "pnpm docs:check:links && pnpm docs:check:line-count",
    "check:standards-redundant": "node scripts/governance/check-standards-redundant.mjs",
    "check:standards-redundant:strict": "node scripts/governance/check-standards-redundant.mjs --strict",
    "ai:check": "node scripts/ai/check-governance.mjs",
    "governance:check": "pnpm check:standards-redundant:strict && pnpm ai:check && pnpm docs:check",
    "verify": "pnpm lint:check && pnpm lint:css:check && pnpm lint:md:check && pnpm typecheck && pnpm test && pnpm build && pnpm docs:build && pnpm governance:check",
    "setup:ai": "node scripts/setup/setup-ai.mjs",
    "commit": "cz",
    "prepare": "husky",
    "release": "semantic-release"
  },
  "dependencies": {
    "@lucide/vue": "^1.45.0",
    "reka-ui": "^2.10.4"
  },
  "devDependencies": {
    "@lint-md/cli": "^2.3.1",
    "@playwright/test": "^1.63.0",
    "@tsdown/css": "^0.23.0",
    "@types/node": "^26.5.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^3.2.4",
    "commitizen": "^4.3.2",
    "commitlint": "^21.2.2",
    "commitlint-config-cmyr": "^1.0.1",
    "cross-env": "^10.0.0",
    "cz-conventional-changelog-cmyr": "^2.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.34.0",
    "eslint-config-cmyr": "^2.3.1",
    "eslint-plugin-vue": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "sass": "^1.104.0",
    "semantic-release": "^25.0.9",
    "semantic-release-cmyr-config": "^1.0.2",
    "stylelint": "^17.15.0",
    "stylelint-config-cmyr": "^1.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "unplugin-vue": "^7.2.0",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "author": "CaoMeiYouRen",
  "description": "一个基于 Vue 3 和 Reka UI 的自建组件库，强调组件与样式解耦，默认提供极简可用的样式并支持 100% 自定义覆盖。开箱即用主题切换与暗色模式，组件设计适配桌面端与移动端。",
  "keywords": [
    "vue3",
    "component-library",
    "reka-ui",
    "theme-switch",
    "responsive",
    "vue",
    "vite"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/CaoMeiYouRen/caomei-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaoMeiYouRen/caomei-ui.git"
  },
  "bugs": {
    "url": "https://github.com/CaoMeiYouRen/caomei-ui/issues"
  },
  "config": {},
  "changelog": {
    "language": "zh"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "npm run lint",
      "git add"
    ]
  }
}