{
  "name": "caomei-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "lint:css": "stylelint src/**/*.{html,css,scss,sass,vue} --fix",
    "release": "semantic-release",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "cross-env NODE_ENV=production eslint . --fix",
    "commit": "cz",
    "prepare": "husky",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "normalize.css": "^8.0.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "commitizen": "^4.3.2",
    "commitlint": "^21.2.2",
    "commitlint-config-cmyr": "^1.0.1",
    "cross-env": "^10.0.0",
    "cz-conventional-changelog-cmyr": "^2.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.34.0",
    "eslint-config-cmyr": "^2.3.1",
    "eslint-plugin-vue": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "sass": "^1.104.0",
    "semantic-release": "^25.0.9",
    "semantic-release-cmyr-config": "^1.0.2",
    "stylelint": "^17.15.0",
    "stylelint-config-cmyr": "^1.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.11"
  },
  "author": "CaoMeiYouRen",
  "description": "一个基于 Vue 3 和 Reka UI 的自建组件库，强调组件与样式解耦，默认提供极简可用的样式并支持 100% 自定义覆盖。开箱即用主题切换与暗色模式，组件设计适配桌面端与移动端。",
  "keywords": [
    "vue3",
    "component-library",
    "reka-ui",
    "theme-switch",
    "responsive",
    "vue",
    "vite"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/CaoMeiYouRen/caomei-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaoMeiYouRen/caomei-ui.git"
  },
  "bugs": {
    "url": "https://github.com/CaoMeiYouRen/caomei-ui/issues"
  },
  "config": {},
  "changelog": {
    "language": "zh"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "npm run lint",
      "git add"
    ]
  }
}